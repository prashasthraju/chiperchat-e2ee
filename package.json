{
  "name": "chiperchat-e2ee",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end encrypted minimal chatting application",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "test": "echo \"Tests will be configured later\"",
    "build:packages": "npm run build --workspace=@cipherchat/shared && npm run build --workspace=@cipherchat/crypto",
    "dev:server": "npm run dev --workspace=server",
    "e2e": "npm run e2e --workspace=@cipherchat/crypto"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prashasthraju/chiperchat-e2ee.git"
  },
  "keywords": [
    "signal-protocol",
    "e2ee",
    "chat"
  ],
  "author": "",
  "license": "ISC"
}
