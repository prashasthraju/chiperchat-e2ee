.env
.env.*
!.env.example
*.local
*.pem
*.key
*.crt
*.p12

# ---- Databases / local data ----
databases/data/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.rdb
*.aof
dump.rdb

# ---- Docker ----
docker-compose.override.yaml
docker-compose.override.yml

# ---- Logs & runtime ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock

# ---- Test / tooling caches ----
.cache/
.parcel-cache/
.vitest/
playwright-report/
test-results/

# ---- Editors & OS ----
